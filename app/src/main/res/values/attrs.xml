<?xml version="1.0" encoding="utf-8"?>

<resources>
    <attr name="accentOrTextSecondary" format="color" />
    <attr name="primaryOrTextSecondary" format="color" />
    <attr name="primaryOrTextPrimary" format="color" />
    <attr name="selectedColorPrimary" format="color" />
    <attr name="whiteOrTextPrimary" format="color" />
    <!-- Text of the dialog buttons: primaryOrTextPrimary, a lighter tone at night where that is unreadable -->
    <attr name="dialogButtonColor" format="color" />
    <!-- Tinted elevated surface of the raised cards (routes, groups); each theme tints it towards its primary -->
    <attr name="cardElevatedSurfaceColor" format="color" />

    <!-- JSON editor preference -->
    <declare-styleable name="EditConfigPreference">
        <!-- Schema roots of the document, `|`-separated JSON pointers into assets/schema/sing-box.json ("#" = the whole config). -->
        <attr name="jsonSchema" format="string" />
        <!-- A blank document is saved as "not set". -->
        <attr name="jsonAllowEmpty" format="boolean" />
        <!-- The document must be a JSON object (default true). -->
        <attr name="jsonRequireObject" format="boolean" />
    </declare-styleable>
</resources>
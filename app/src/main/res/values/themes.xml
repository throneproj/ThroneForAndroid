        <item name="cardElevatedSurfaceColor">@color/card_elevated_pink</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.MaterialComponents.MediumComponent
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.SagerNet.AlertDialog
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialCardViewStyle">@style/Widget.SagerNet.CardView</item>
        <item name="textInputStyle">@style/Widget.SagerNet.TextInputLayout</item>
        <item name="popupMenuStyle">@style/Widget.SagerNet.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.SagerNet.PopupMenu.Overflow</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SagerNet.BottomSheetDialog</item>
        <item name="materialButtonStyle">@style/Widget.SagerNet.Button</item>
        <item name="textAppearanceButton">@style/TextAppearance.SagerNet.Button</item>
        <item name="tabStyle">@style/Widget.SagerNet.TabLayout</item>
        <item name="dialogButtonColor">?attr/primaryOrTextPrimary</item>

        <item name="android:dialogCornerRadius">@dimen/dialog_corner_radius</item>

        <item name="windowFixedHeightMajor" type="dimen">95%</item>

    </style>

    <!-- Dialog activities sized by their content (the updater) instead of the dialog theme's fixed 95% height -->
    <style name="ThemeOverlay.SagerNet.Dialog.WrapHeight" parent="">
        <item name="windowFixedHeightMajor">@null</item>
        <item name="windowFixedHeightMinor">@null</item>
    </style>

    <!-- Every alert dialog: MaterialAlertDialogBuilder, and AppCompat's builder (the preference dialogs) through
         ThemeOverlay.SagerNet.AlertDialog. The Material 3 layout keeps the buttons on the 24dp content margins. -->
    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.SagerNet</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SagerNet.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.SagerNet.Title.Text</item>
        <item name="buttonBarButtonStyle">@style/Widget.SagerNet.Button.TextButton.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.SagerNet.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.SagerNet.Button.TextButton.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.SagerNet.Button.TextButton.Dialog.Flush</item>
    </style>

    <style name="MaterialAlertDialog.SagerNet" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.SagerNet.Dialog</item>
    </style>

    <style name="MaterialAlertDialog.SagerNet.Title.Text" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textAppearance">?attr/textAppearanceHeadline6</item>
    </style>

    <!-- Sentence case with Material 3's label spacing instead of spaced-out capitals: textAppearanceButton (buttons,
         snackbar actions), the dialog buttons and the tabs -->
    <style name="TextAppearance.SagerNet.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0.00714</item>
    </style>

    <!-- Tab colours stay the theme attrs the layouts pass (tabTextColor and the rest) -->
    <style name="Widget.SagerNet.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.SagerNet.Button</item>
    </style>

    <style name="ShapeAppearanceOverlay.SagerNet.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.SagerNet.Button.TextButton.Dialog" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAppearance">@style/TextAppearance.SagerNet.Button</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="rippleColor">@color/dialog_button_ripple</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SagerNet.Pill</item>
    </style>

    <style name="Widget.SagerNet.Button.TextButton.Dialog.Flush">
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginLeft">0dp</item>
    </style>

    <!-- Section notes (category summaries) wrap instead of being cut to one line -->
    <style name="PreferenceThemeOverlay.SagerNet" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryStyle">@style/Preference.Category.SagerNet</item>
    </style>

    <style name="Preference.Category.SagerNet" parent="Preference.Category.Material">
        <item name="android:layout">@layout/layout_preference_category</item>
    </style>

    <style name="Widget.MaterialComponents.Chip.Choice.SagerNet">
        <item name="textStartPadding">30dp</item>
        <item name="textEndPadding">30dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconTint">?primaryOrTextPrimary</item>
        <item name="rippleColor">@color/chip_ripple_color</item>
    </style>

    <style name="Widget.SagerNet.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <!-- ElevatedCard: shadow + tonal surface, no stroke. -->
    <style name="Widget.SagerNet.CardView.Elevated">
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">?attr/cardElevatedSurfaceColor</item>
    </style>

    <style name="Widget.SagerNet.CardView.Tinted" parent="Widget.SagerNet.CardView">
        <item name="cardBackgroundColor">?attr/cardElevatedSurfaceColor</item>
    </style>

    <style name="ShapeAppearanceOverlay.SagerNet.Dialog" parent="">
        <item name="cornerFamily">rounded</item>

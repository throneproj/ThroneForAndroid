    <!-- AMOLED black overlay: applied at night by Theme.apply/applyDialog; only background, surface and card colours.
         parent="" cuts the implicit dotted-name inheritance (Theme.SagerNet would be layered on and lock the colours) -->
    <style name="Theme.SagerNet.Amoled" parent="">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="cardElevatedSurfaceColor">@color/card_elevated_amoled</item>
        <!-- No elevation overlay on OLED black: it would lighten black surfaces by elevation (a 4dp toolbar becomes #181818) -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- White theme night fallback + OLED: White.Night with the app bar (colorPrimary) darkened to black -->
    <style name="Theme.SagerNet.Amoled.White" parent="">
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>

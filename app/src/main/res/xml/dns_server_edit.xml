<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/dns_server_info">
        <EditTextPreference
            app:key="tag"
            app:title="@string/dns_server_tag"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogMessage="@string/dns_server_address_hint"
            app:key="address"
            app:title="@string/dns_server_address"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:entries="@array/dns_server_type_entries"
            app:entryValues="@array/dns_server_type_values"
            app:key="type"
            app:title="@string/dns_server_type"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/dns_server_advanced">
        <EditTextPreference
            app:key="bind_interface"
            app:title="@string/dns_server_bind_interface"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="detour"
            app:title="@string/dns_server_detour"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="client_subnet"
            app:title="@string/dns_server_client_subnet"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:key="disable_cache"
            app:title="@string/dns_server_disable_cache" />
        <SwitchPreference
            app:key="disable_expire"
            app:title="@string/dns_server_disable_expire" />
        <SwitchPreference
            app:key="ip_is_private"
            app:title="@string/dns_server_ip_is_private" />
        <SwitchPreference
            app:key="reject_expired"
            app:title="@string/dns_server_reject_expired" />
    </PreferenceCategory>
</PreferenceScreen>

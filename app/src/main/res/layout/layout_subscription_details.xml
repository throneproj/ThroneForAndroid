<?xml version="1.0" encoding="utf-8"?>
<!-- SubscriptionInfoCard's details sheet: what the provider sent; the rows are added in code. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/sub_details_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="?android:attr/textColorPrimary"
            android:textDirection="firstStrong"
            tools:text="My subscription" />

        <LinearLayout
            android:id="@+id/sub_details_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/sub_details_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sub_details_website"
                style="@style/Widget.SagerNet.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subinfo_website"
                app:cornerRadius="24dp"
                app:icon="@drawable/baseline_public_24"
                app:iconTint="@color/dialog_button_text" />

            <Space
                android:id="@+id/sub_details_button_gap"
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sub_details_support"
                style="@style/Widget.SagerNet.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subinfo_support"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_baseline_chat_bubble_outline_24"
                app:iconTint="@color/dialog_button_text" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
